# =============================================================================
# tableau-desktop-mcp - example configuration
# Copy to ".env" and adjust the paths for your machine.
# All paths may be absolute or relative to the project root.
# =============================================================================

# Authorized folder that contains the .twb workbooks the MCP is allowed to touch.
# The server will NEVER read or write outside of this folder (path-traversal safe).
TABLEAU_MCP_WORKBOOKS_DIR=workbooks

# Where automatic and manual backups are stored.
TABLEAU_MCP_BACKUPS_DIR=backups

# Where structured logs are written.
TABLEAU_MCP_LOGS_DIR=logs

# Logging level: DEBUG | INFO | WARNING | ERROR
TABLEAU_MCP_LOG_LEVEL=INFO

# Maximum workbook size (bytes) the server will open. Default 50 MB.
TABLEAU_MCP_MAX_FILE_SIZE_BYTES=52428800
